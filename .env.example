# copy to .env and adjust

# public port the app is served on
HTTP_PORT=8080

# change these before first start
POSTGRES_PASSWORD=mediasys
S3_ACCESS_KEY=mediasys
S3_SECRET_KEY=change-me-please
JWT_SECRET=

# comma-separated origins allowed to call auth/admin routes cross-origin
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# face detection / recognition models are mounted read-only from here
MODELS_DIR=./ml-models
FACE_RECOGNITION_ENABLED=true
CUDA_ENABLED=false

MAX_UPLOAD_SIZE_MB=200
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
