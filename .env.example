# copy to .env and adjust

# public port the app is served on
HTTP_PORT=8080

# host port for the storage (Silo/MinIO) web console; bound to 127.0.0.1 only
STORAGE_CONSOLE_PORT=9001

# --- required secrets --------------------------------------------------------
# JWT_SECRET is required: the server refuses to start without it, rejects the old
# known default and anything shorter than 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
# S3_SECRET_KEY is required too (docker compose refuses to start without it).
# Also used as the storage root password, so change it before first start.
S3_ACCESS_KEY=mediasys
S3_SECRET_KEY=

# --- database ----------------------------------------------------------------
POSTGRES_USER=mediasys
POSTGRES_PASSWORD=mediasys
POSTGRES_DB=mediasys
# log every SQL statement
DATABASE_DEBUG=false

# --- object storage ----------------------------------------------------------
S3_BUCKET=mediasys
S3_REGION=us-east-1

# --- web ---------------------------------------------------------------------
# comma-separated origins allowed to call auth/admin routes cross-origin
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# optional: externally visible base URL, used for absolute links in share pages
# (Open Graph previews). When empty, the request's Host/X-Forwarded-* headers are used.
PUBLIC_URL=

MAX_UPLOAD_SIZE_MB=200
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- background processing ---------------------------------------------------
THUMBNAIL_MAX_SIZE=300
THUMBNAIL_QUEUE_SIZE=50
NUM_THUMBNAIL_WORKERS=2
NUM_DETECTION_WORKERS=1
DETECTION_QUEUE_SIZE=10
# how often to return freed memory to the OS; 0 disables
MEMORY_TRIM_INTERVAL_MINUTES=30
# soft memory limit read by the Go runtime, e.g. 2GiB (empty = no limit)
GOMEMLIMIT=

# --- face detection / recognition --------------------------------------------
# models are mounted read-only from here
MODELS_DIR=./ml-models
FACE_RECOGNITION_ENABLED=true
FACE_RECOGNITION_MODEL_NAME=arcface
# similarity threshold for matching faces, between 0 and 1
FACE_RECOGNITION_THRESHOLD=0.6
# CUDA is only useful with a CUDA-enabled OPENCV_IMAGE (see readme)
CUDA_ENABLED=false
RETINAFACE_CUDA=false
ARCFACE_CUDA=false
# base image the backend is built from (and links against)
OPENCV_IMAGE=ghcr.io/hybridgroup/opencv:4.11.0
